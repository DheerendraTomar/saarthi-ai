{
  "name": "ollama-pilot",
  "displayName": "Saarthi AI",
  "description": "Copilot-style inline completions and agent chat, running entirely on your machine via Ollama.",
  "version": "0.2.2",
  "icon": "media/icon.png",
  "publisher": "thelaconicguy",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localpilot",
          "title": "LocalPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "localpilot": [
        {
          "type": "webview",
          "id": "localpilot.chat",
          "name": "Chat",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "localpilot.openChat",
        "title": "Open Chat",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.newSession",
        "title": "New Chat Session",
        "category": "LocalPilot",
        "icon": "$(add)"
      },
      {
        "command": "localpilot.startOllama",
        "title": "Start Ollama",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.pullModel",
        "title": "Pull Model",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.toggleCompletions",
        "title": "Toggle Inline Completions",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.restartCore",
        "title": "Restart Core",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.selectChatModel",
        "title": "Select Chat Model",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.selectCompletionModel",
        "title": "Select Completion Model",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.deleteSession",
        "title": "Delete Chat Session",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.clearSessions",
        "title": "Clear All Chat Sessions",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.resetLearning",
        "title": "Reset Completion Learning",
        "category": "LocalPilot"
      },
      {
        "command": "localpilot.showCompletionStats",
        "title": "Show Completion Stats",
        "category": "LocalPilot"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "localpilot.openChat",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.newSession",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.startOllama",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.pullModel",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.toggleCompletions",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.restartCore",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.selectChatModel",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.selectCompletionModel",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.deleteSession",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.clearSessions",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.resetLearning",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "localpilot.showCompletionStats",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "view/title": [
        {
          "command": "localpilot.newSession",
          "when": "view == localpilot.chat",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "localpilot.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "title": "LocalPilot",
      "properties": {
        "localpilot.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of the local Ollama server. LocalPilot talks to nothing else."
        },
        "localpilot.completionModel": {
          "type": "string",
          "default": "qwen2.5-coder:0.5b-base",
          "description": "Small fill-in-the-middle model used for inline completions (qwen2.5-coder:1.5b-base is the higher-quality alternative)."
        },
        "localpilot.chatModel": {
          "type": "string",
          "default": "qwen3.8:27b-mlx",
          "description": "Tool-calling model used for agent chat."
        },
        "localpilot.completionsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inline (ghost text) completions."
        },
        "localpilot.completionDebounceMs": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "description": "Delay after the last keystroke before a completion is requested."
        },
        "localpilot.completionMaxTokens": {
          "type": "number",
          "default": 32,
          "minimum": 1,
          "description": "Maximum tokens generated per inline completion."
        },
        "localpilot.chatThinking": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ],
          "default": "off",
          "description": "Let the chat model think before answering (slower)."
        },
        "localpilot.coreBinaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to a localpilot-core binary that overrides the bundled one."
        },
        "localpilot.allowedCommandsAlways": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Commands approved with \"Always\"; the agent runs these without asking."
        },
        "localpilot.completionContextTokens": {
          "type": "number",
          "default": 3584,
          "minimum": 256,
          "description": "Total prompt budget for inline completions (prefix + suffix + related snippets)."
        },
        "localpilot.chatContextTokens": {
          "type": "number",
          "default": 24000,
          "minimum": 1024,
          "description": "Chat history budget before older turns are dropped."
        },
        "localpilot.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Core log level (logs go to <workspace>/.localpilot/core.log)."
        },
        "localpilot.adaptiveCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Adapt inline completion length and add style examples from your past accepts/rejects (logged locally in <workspace>/.localpilot/completions.jsonl). Off: the configured limits, no examples; outcomes are still logged."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "build:e2e": "esbuild test/e2e/runTests.ts test/e2e/suite/index.ts test/e2e/suite/smoke.test.ts --bundle --platform=node --format=cjs --target=node20 --outdir=out-test --outbase=test/e2e --external:vscode --external:mocha --external:@vscode/test-electron",
    "test:e2e": "node esbuild.mjs && npm run build:e2e && node out-test/runTests.js"
  },
  "dependencies": {
    "@localpilot/rpc-client": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.0",
    "esbuild": "0.21.5",
    "eslint": "9.15.0",
    "globals": "14.0.0",
    "mocha": "10.8.2",
    "ovsx": "^1.3.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.5"
  }
}
